{
  "name": "reteamnow-app",
  "version": "0.1.0",
  "private": true,
  "description": "Employee Engagement Platform — Attendance tracking, health & fitness integration, team competitions, and team communication.",
  "keywords": [
    "react-native",
    "employee-engagement",
    "attendance",
    "health-connect",
    "fitness-tracking",
    "team-communication",
    "mobile-app"
  ],
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,js}\"",
    "format:check": "prettier --check src/",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "clean": "cd android && ./gradlew clean && cd .. && cd ios && xcodebuild clean && cd ..",
    "reset": "npx react-native start --reset-cache",
    "backend:dev": "cd backend && npm run dev",
    "backend:start": "cd backend && npm start",
    "backend:install": "cd backend && npm install"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-native-picker/picker": "^2.11.1",
    "@react-native-vector-icons/material-design-icons": "^12.3.0",

    "@react-navigation/bottom-tabs": "^7.4.5",
    "@react-navigation/drawer": "^7.5.6",
    "@react-navigation/native": "^7.1.16",
    "@react-navigation/native-stack": "^7.3.24",
    "axios": "^1.11.0",

    "react": "19.1.0",
    "react-native": "0.80.2",
    "react-native-bootsplash": "^6.3.10",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-gifted-charts": "^1.4.63",
    "react-native-health-connect": "^3.3.3",
    "react-native-image-picker": "^8.2.1",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-pager-view": "^6.9.1",
    "react-native-reanimated": "^4.0.2",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.13.1",
    "react-native-svg": "^15.12.1",
    "react-native-toast-message": "^2.3.3",
    "react-native-vector-icons": "^10.3.0",
    "react-native-worklets": "^0.4.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-flow-strip-types": "^7.27.1",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^19.1.1",
    "@react-native-community/cli-platform-android": "19.1.1",
    "@react-native-community/cli-platform-ios": "19.1.1",
    "@react-native/babel-preset": "0.80.2",
    "@react-native/eslint-config": "0.80.2",
    "@react-native/metro-config": "0.80.2",
    "@react-native/typescript-config": "^0.80.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",

    "prettier": "2.8.8",
    "react-native-dotenv": "^3.4.11",
    "react-test-renderer": "19.1.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
