# Server Configuration
NODE_ENV=dev
PORT=8017
BACKEND_API_URL=http://localhost:8017

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGODB_NAME=reteamnow

# Authentication
JWT_SECRET=your_jwt_secret_here
JWT_LIFETIME=90

# Client
CLIENT_URL=http://localhost:3000

# Email (Nodemailer)
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password

# Google APIs
GOOGLE_CREDENTIALS_PATH=./utils/service-account.json

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# AWS S3 (if applicable)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_KEY_ID=your_aws_secret_key
AWS_BUCKET_NAME=your_bucket_name

# Sync / Cron
SYNC_DVDS_DOC_AUTOMATION_CRON=false
SYNC_DVDS_DOC_AUTOMATION_CRON_TIME=0 7 * * *

# MongoDB Atlas (alternative to MONGO_URI)
MONGO_URL=
