# ⚙️ ReteamNow Environment Configuration
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control!

# Backend API base URL (required)
# For local development: http://<your-ip>:8062/api
# For production: https://your-app-backend.com/api
API_BASE_URL=http://localhost:8062/api

# Optional: App environment (development | staging | production)
# APP_ENV=development
